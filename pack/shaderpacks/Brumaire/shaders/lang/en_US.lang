value.SKY_RAYS.0=Off
value.SKY_RAYS.1=On
option.HEAT_LIGHTNING=Heat lightning
option.HEAT_LIGHTNING.comment=On hot, sultry nights, storms too far away to be heard silently light up cloud banks low on the horizon.
value.HEAT_LIGHTNING.0=Off
value.HEAT_LIGHTNING.1=On
option.WATER_GLITTER=Water glitter
option.WATER_GLITTER.comment=On sunlit water, ripples too small to be drawn flash the sun back in sparkles that come and go.
value.WATER_GLITTER.0=Off
value.WATER_GLITTER.1=On
option.WATER_GUSTS=Cat's paws
